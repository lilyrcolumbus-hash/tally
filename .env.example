# Tally.ly — environment variables
# Copy this file to ".env.local" and fill in your values.
# The app runs WITHOUT any of these (local + demo mode); fill them to unlock cloud + AI + Sheets.

# --- AI (voice + photo extraction). Get a free key at https://aistudio.google.com/apikey
# LOCAL DEV ONLY: this calls Gemini straight from the browser.
# In PRODUCTION do NOT set this. Instead set a server secret named GEMINI_API_KEY
# (no VITE_ prefix) in Cloudflare → the /api/extract function keeps the key hidden.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Cloud database (Supabase). From your project's Settings → API.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Google Sheets mirror. The Web app URL from the Apps Script deployment.
VITE_SHEETS_WEBHOOK_URL=YOUR_APPS_SCRIPT_WEB_APP_URL
# The same long random string you set as the TALLY_TOKEN Script Property in Apps Script,
# so the public URL can't be abused. (You can also enter these in the app: Settings -> Use your own accounts.)
VITE_SHEETS_TOKEN=YOUR_LONG_RANDOM_TOKEN

# --- Default currency for new entries (USD, EUR, MXN, COP, ...)
VITE_DEFAULT_CURRENCY=USD
